# Groq API Configuration
GROQ_API_KEY=gsk_your_actual_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Amazon S3 Cloud Object Storage Sync
# Set these if you want uploaded PDFs to automatically sync to an S3 Bucket viewable in AWS Console
S3_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=us-east-1

# If running locally or without IAM role on EC2, you can also specify:
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
